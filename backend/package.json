{
  "name": "erp-socks-backend",
  "version": "1.0.0",
  "description": "SockERP backend — Lambda functions for socks manufacturing ERP",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "build": "npm run lint && npm test",
    "package": "zip -r function.zip src node_modules package.json"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.622.0",
    "@aws-sdk/client-s3": "3.622.0",
    "@aws-sdk/s3-request-presigner": "3.622.0",
    "aws-lambda": "1.0.7",
    "jwks-rsa": "3.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.143",
    "@types/pg": "8.11.6",
    "eslint": "9.9.0",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  },
  "license": "UNLICENSED",
  "private": true
}
